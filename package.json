{
  "name": "agent-session-pack",
  "version": "0.4.1",
  "description": "Pack cold local AI coding-agent sessions with byte-exact restore.",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "ai-session-cleanup",
    "ai-session-history",
    "coding-agents",
    "agent-sessions",
    "session-management",
    "session-compression",
    "storage-cleanup",
    "compression",
    "disk-cleanup",
    "developer-disk-cleanup",
    "local-first",
    "zstd",
    "jsonl",
    "codex",
    "codex-cli",
    "openai-codex",
    "claude-code",
    "claude",
    "kiro",
    "kiro-cli",
    "grok",
    "grok-cli",
    "kimi",
    "kimi-code",
    "opencode",
    "gemini",
    "gemini-cli",
    "devin",
    "cursor",
    "cli",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YosefHayim/agent-session-pack.git"
  },
  "bugs": {
    "url": "https://github.com/YosefHayim/agent-session-pack/issues"
  },
  "homepage": "https://github.com/YosefHayim/agent-session-pack#readme",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "bin": {
    "agent-session-pack": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "dev:guide": "tsx src/cli.ts guide",
    "dev:savings": "tsx src/cli.ts savings",
    "prod": "npm run build && node dist/cli.js",
    "build": "tsc && node --input-type=module -e \"import { readdir, rm } from 'node:fs/promises'; import { join } from 'node:path'; async function removeEmittedTests(directory) { const dirents = await readdir(directory, { withFileTypes: true }); for (const dirent of dirents) { const filePath = join(directory, dirent.name); if (dirent.isDirectory()) { await removeEmittedTests(filePath); continue; } const isEmittedTest = dirent.name.endsWith('.test.js') || dirent.name.endsWith('.test.js.map'); if (isEmittedTest) await rm(filePath); } } await removeEmittedTests('dist');\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest watch --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "biome check . && tsc --noEmit && vitest run --project unit && npm run build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
