{
  "name": "agent-session-pack",
  "version": "0.3.0",
  "description": "Pack cold local AI coding-agent sessions with byte-exact restore.",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "ai-session-cleanup",
    "ai-session-history",
    "coding-agents",
    "agent-sessions",
    "session-management",
    "session-compression",
    "storage-cleanup",
    "compression",
    "disk-cleanup",
    "developer-disk-cleanup",
    "local-first",
    "zstd",
    "jsonl",
    "codex",
    "codex-cli",
    "openai-codex",
    "claude-code",
    "claude",
    "kiro",
    "kiro-cli",
    "grok",
    "grok-cli",
    "kimi",
    "kimi-code",
    "opencode",
    "gemini",
    "gemini-cli",
    "devin",
    "cursor",
    "cli",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YosefHayim/agent-session-pack.git"
  },
  "bugs": {
    "url": "https://github.com/YosefHayim/agent-session-pack/issues"
  },
  "homepage": "https://github.com/YosefHayim/agent-session-pack#readme",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "bin": {
    "agent-session-pack": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "LICENSE",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/cli/main.ts",
    "dev:guide": "tsx src/cli/main.ts guide",
    "dev:savings": "tsx src/cli/main.ts savings",
    "prod": "pnpm build && node dist/cli/main.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && knip",
    "lint:fix": "biome check --write .",
    "check": "turbo run lint typecheck test build --output-logs=errors-only",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "citty": "0.2.2",
    "effect": "3.22.4",
    "zod": "4.6.7"
  }
}
